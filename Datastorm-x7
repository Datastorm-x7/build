ody {  font-family: 'Roboto', sans-serif;  margin: 0;  padding: 0;  background-color: #f9f9f9;  color: #333;}.container {  max-width: 1200px;  margin: 0 auto;  padding: 20px;}.header {  background-color: #111;  color: white;  padding: 20px 0;}.logo {  font-size: 28px;  font-weight: 700;}.nav ul {  list-style: none;  display: flex;  gap: 15px;  padding: 0;}.nav a {  text-decoration: none;  font-weight: bold;}.hero {  background-color: #222;  color: white;  padding: 60px 20px;  text-align: center;}.hero h2 {  font-size: 36px;  margin-bottom: 10px;}.about, .services, .work, .blog, .contact, .payment {  padding: 40px 20px;  background-color: white;  margin-bottom: 10px;  border-radius: 8px;  box-shadow: 0 2px 8px rgba(0,0,0,0.05);}h3, h4 {  color: #222;}ul {  padding-left: 20px;}form input, form textarea {  width: 100%;  margin-bottom: 10px;  border: 1px solid #ccc;  border-radius: 5px;}form button, input[type="submit"] {  background-color: #111;  color: white;  border: none;  padding: 12px 20px;  border-radius: 5px;  cursor: pointer;}form button:hover, input[type="submit"]:hover {  background-color: #333;}.footer {  background-color: #111;  color: white;  text-align: center;  padding: 20px;  margin-top: 20px;}
